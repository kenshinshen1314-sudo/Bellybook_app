# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
# IMPORTANT: In Vite, env vars must be prefixed with VITE_ to be accessible in the browser
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Optional: API endpoint (default is Gemini's production endpoint)
# VITE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
